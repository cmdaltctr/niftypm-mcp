# NiftyPM OAuth Credentials
NIFTYPM_CLIENT_ID=your_client_id_here
NIFTYPM_CLIENT_SECRET=your_client_secret_here
NIFTYPM_ACCESS_TOKEN=your_access_token_here
NIFTYPM_REFRESH_TOKEN=your_refresh_token_here

# Team Token (required for checklist write operations)
# Obtained from the nifty_auth cookie's teamToken field.
# To extract: log into NiftyPM in a browser, open DevTools console, run:
#   JSON.parse(decodeURIComponent(document.cookie.match(/nifty_auth=([^;]+)/)[1])).teamToken
NIFTYPM_TEAM_TOKEN=

# Tool Configuration (set to "false" to disable)
ENABLE_FILES=true
ENABLE_LABELS=true
ENABLE_DOCUMENTS=true
ENABLE_MILESTONES=true
ENABLE_MESSAGES=true
ENABLE_TASK_GROUPS=true
ENABLE_TASKS=true
ENABLE_SUBTEAMS=true

# New domains
ENABLE_PROJECTS=true
ENABLE_FOLDERS=true
ENABLE_MEMBERS=true
ENABLE_WEBHOOKS=true
ENABLE_TIME=true
ENABLE_FIELDS=true
ENABLE_APPS=true
ENABLE_CHAT=true
ENABLE_INVITE=true
ENABLE_TEMPLATES=true
ENABLE_USERS=true
ENABLE_AUTH=true
ENABLE_CHECKLISTS=true
